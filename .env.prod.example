# Production TEMPLATE, not the effective server configuration.
# Copy to .env.prod only for initial preparation. Never overwrite a live file.
# root:root 0600; installation/rotation: docs/SECRETS_ROTATION.md
SECRET_KEY=your-secret-key-here-change-this-to-a-random-50-character-string
SECRET_KEY_FALLBACKS_JSON='[]'
DEBUG=False
ALLOWED_HOSTS=polis.insflow.ru

# Single source: Compose maps POSTGRES_* to the app's DB_* at db:5432.
# A changed env password does not change an existing PostgreSQL role password.
POSTGRES_DB=insurance_broker_prod
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-strong-database-password-here

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Generic Django email. Configure explicitly if this separate contour is used.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Only these security settings are read from env; the rest are code/Nginx policy.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Business outbox: separate from Django EMAIL_* (docs/EMAIL_COMMUNICATIONS_SETUP.md)
# Keep disabled until SMTP and the permitted test recipient have been verified.
COMMUNICATIONS_EMAIL_ENABLED=False
COMMUNICATIONS_DEFAULT_ACCOUNT=billing
COMMUNICATIONS_SMTP_HOST=
COMMUNICATIONS_SMTP_PORT=465
COMMUNICATIONS_SMTP_USE_SSL=True
COMMUNICATIONS_SMTP_USE_TLS=False
COMMUNICATIONS_SMTP_USERNAME=
COMMUNICATIONS_SMTP_PASSWORD=
COMMUNICATIONS_FROM_EMAIL=
COMMUNICATIONS_FROM_NAME=
COMMUNICATIONS_BCC_EMAILS=
COMMUNICATIONS_MESSAGE_ID_DOMAIN=
COMMUNICATIONS_ATTACHMENT_MAX_SIZE_MB=10
COMMUNICATIONS_SEND_TIMEOUT=30
COMMUNICATIONS_RESTRICT_TO_SUPERUSER=True
BILLING_AUTO_UPDATE_TASK_ON_EMAIL_SENT=True

# Optional notifications. No real tokens/recipients belong in this file.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SOCKS5_PROXY=
TELEGRAM_UPLOAD_FILES=true
TELEGRAM_MAX_FILE_SIZE=45
TELEGRAM_ERROR_RATE_LIMIT=10
VK_ENABLED=false
VK_COMMUNITY_TOKEN=
VK_USER_ID=

# Optional Sentry. See the current before_send issue in docs/MONITORING.md#sentry.
SENTRY_DSN=
SENTRY_RELEASE=unknown

# Optional backup discovery from the application
BACKUP_BASE_DIR=
BACKUP_DB_DIR=
BACKUP_MEDIA_DIR=

# InsFlow / ZS handoff: configure the same service token on both servers.
FLOW_HANDOFF_ENABLED=false
FLOW_ZS_BASE_URL=https://zs.insflow.ru
FLOW_SERVICE_TOKEN=
